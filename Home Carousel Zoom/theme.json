{
  "name": "Home Carousel Zoom",
  "author": "beallio",
  "version": "v1.1.0",
  "target": "Home",
  "manifest_version": 8,
  "description": "Enlarge Home carousel covers from 100% to 210% with additive zoom sliders. Default: 115%. Artwork glow works in both focus modes. Highlight color, outline thickness, and halo strength work only in Custom mode. The Library grid and View more in your Library card keep their normal size.",
  "inject": {
    "shared.css": ["bigpicture"]
  },
  "patches": {
    "Base zoom (%)": {
      "type": "slider",
      "default": "110",
      "values": {
        "100": {"--hcz-base-scale": ["1", "bigpicture"]},
        "110": {"--hcz-base-scale": ["1.1", "bigpicture"]},
        "120": {"--hcz-base-scale": ["1.2", "bigpicture"]},
        "130": {"--hcz-base-scale": ["1.3", "bigpicture"]},
        "140": {"--hcz-base-scale": ["1.4", "bigpicture"]},
        "150": {"--hcz-base-scale": ["1.5", "bigpicture"]},
        "160": {"--hcz-base-scale": ["1.6", "bigpicture"]},
        "170": {"--hcz-base-scale": ["1.7", "bigpicture"]},
        "180": {"--hcz-base-scale": ["1.8", "bigpicture"]},
        "190": {"--hcz-base-scale": ["1.9", "bigpicture"]},
        "200": {"--hcz-base-scale": ["2", "bigpicture"]}
      }
    },
    "Fine adjustment": {
      "type": "slider",
      "default": "+5",
      "values": {
        "+0": {"--hcz-fine-scale": ["0", "bigpicture"]},
        "+1": {"--hcz-fine-scale": ["0.01", "bigpicture"]},
        "+2": {"--hcz-fine-scale": ["0.02", "bigpicture"]},
        "+3": {"--hcz-fine-scale": ["0.03", "bigpicture"]},
        "+4": {"--hcz-fine-scale": ["0.04", "bigpicture"]},
        "+5": {"--hcz-fine-scale": ["0.05", "bigpicture"]},
        "+6": {"--hcz-fine-scale": ["0.06", "bigpicture"]},
        "+7": {"--hcz-fine-scale": ["0.07", "bigpicture"]},
        "+8": {"--hcz-fine-scale": ["0.08", "bigpicture"]},
        "+9": {"--hcz-fine-scale": ["0.09", "bigpicture"]},
        "+10": {"--hcz-fine-scale": ["0.1", "bigpicture"]}
      }
    },
    "Focus appearance": {
      "type": "dropdown",
      "default": "Steam default",
      "values": {
        "Steam default": {},
        "Custom": {"focus.css": ["bigpicture"]}
      },
      "components": [
        {
          "name": "Highlight color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#ffffff99",
          "css_variable": "hcz-focus-color",
          "tabs": ["bigpicture"]
        }
      ]
    },
    "Use Steam's artwork glow": {
      "type": "checkbox",
      "default": "Yes",
      "values": {
        "Yes": {},
        "No": {"artwork.css": ["bigpicture"]}
      }
    },
    "Artwork opacity (%, override only)": {
      "type": "slider",
      "default": "50",
      "values": {
        "0": {"--hcz-artwork-opacity": ["0", "bigpicture"]},
        "10": {"--hcz-artwork-opacity": ["0.1", "bigpicture"]},
        "20": {"--hcz-artwork-opacity": ["0.2", "bigpicture"]},
        "30": {"--hcz-artwork-opacity": ["0.3", "bigpicture"]},
        "40": {"--hcz-artwork-opacity": ["0.4", "bigpicture"]},
        "50": {"--hcz-artwork-opacity": ["0.5", "bigpicture"]},
        "60": {"--hcz-artwork-opacity": ["0.6", "bigpicture"]},
        "70": {"--hcz-artwork-opacity": ["0.7", "bigpicture"]},
        "80": {"--hcz-artwork-opacity": ["0.8", "bigpicture"]},
        "90": {"--hcz-artwork-opacity": ["0.9", "bigpicture"]},
        "100": {"--hcz-artwork-opacity": ["1", "bigpicture"]}
      }
    },
    "Outline thickness (px, Custom only)": {
      "type": "slider",
      "default": "2",
      "values": {
        "1": {"--hcz-focus-width": ["1px", "bigpicture"]},
        "2": {"--hcz-focus-width": ["2px", "bigpicture"]},
        "3": {"--hcz-focus-width": ["3px", "bigpicture"]},
        "4": {"--hcz-focus-width": ["4px", "bigpicture"]},
        "5": {"--hcz-focus-width": ["5px", "bigpicture"]},
        "6": {"--hcz-focus-width": ["6px", "bigpicture"]},
        "7": {"--hcz-focus-width": ["7px", "bigpicture"]},
        "8": {"--hcz-focus-width": ["8px", "bigpicture"]},
        "9": {"--hcz-focus-width": ["9px", "bigpicture"]},
        "10": {"--hcz-focus-width": ["10px", "bigpicture"]}
      }
    },
    "Halo size (px, Custom only)": {
      "type": "slider",
      "default": "0",
      "values": {
        "0": {"--hcz-glow-blur": ["0px", "bigpicture"], "--hcz-glow-spread": ["0px", "bigpicture"]},
        "5": {"--hcz-glow-blur": ["5px", "bigpicture"], "--hcz-glow-spread": ["1px", "bigpicture"]},
        "10": {"--hcz-glow-blur": ["10px", "bigpicture"], "--hcz-glow-spread": ["2px", "bigpicture"]},
        "15": {"--hcz-glow-blur": ["15px", "bigpicture"], "--hcz-glow-spread": ["3px", "bigpicture"]},
        "20": {"--hcz-glow-blur": ["20px", "bigpicture"], "--hcz-glow-spread": ["4px", "bigpicture"]},
        "25": {"--hcz-glow-blur": ["25px", "bigpicture"], "--hcz-glow-spread": ["5px", "bigpicture"]},
        "30": {"--hcz-glow-blur": ["30px", "bigpicture"], "--hcz-glow-spread": ["6px", "bigpicture"]}
      }
    }
  }
}
