{
  "name": "Home Carousel Zoom",
  "author": "beallio",
  "version": "v1.1.0",
  "target": "Home",
  "manifest_version": 8,
  "description": "Enlarge Home carousel covers on pointer hover or controller selection. Add Base zoom (100-200%) and Fine adjustment (+0-10 percentage points) for 100-210% total zoom. Default: 115%. Keep the existing focus appearance or customize the highlight color, outline thickness, and glow strength. The Library grid and View more in your Library card keep their normal size.",
  "inject": {
    "shared.css": ["bigpicture"]
  },
  "patches": {
    "Base zoom (%)": {
      "type": "slider",
      "default": "110",
      "values": {
        "100": {"--hcz-base-scale": ["1", "bigpicture"]},
        "110": {"--hcz-base-scale": ["1.1", "bigpicture"]},
        "120": {"--hcz-base-scale": ["1.2", "bigpicture"]},
        "130": {"--hcz-base-scale": ["1.3", "bigpicture"]},
        "140": {"--hcz-base-scale": ["1.4", "bigpicture"]},
        "150": {"--hcz-base-scale": ["1.5", "bigpicture"]},
        "160": {"--hcz-base-scale": ["1.6", "bigpicture"]},
        "170": {"--hcz-base-scale": ["1.7", "bigpicture"]},
        "180": {"--hcz-base-scale": ["1.8", "bigpicture"]},
        "190": {"--hcz-base-scale": ["1.9", "bigpicture"]},
        "200": {"--hcz-base-scale": ["2", "bigpicture"]}
      }
    },
    "Fine adjustment": {
      "type": "slider",
      "default": "+5",
      "values": {
        "+0": {"--hcz-fine-scale": ["0", "bigpicture"]},
        "+1": {"--hcz-fine-scale": ["0.01", "bigpicture"]},
        "+2": {"--hcz-fine-scale": ["0.02", "bigpicture"]},
        "+3": {"--hcz-fine-scale": ["0.03", "bigpicture"]},
        "+4": {"--hcz-fine-scale": ["0.04", "bigpicture"]},
        "+5": {"--hcz-fine-scale": ["0.05", "bigpicture"]},
        "+6": {"--hcz-fine-scale": ["0.06", "bigpicture"]},
        "+7": {"--hcz-fine-scale": ["0.07", "bigpicture"]},
        "+8": {"--hcz-fine-scale": ["0.08", "bigpicture"]},
        "+9": {"--hcz-fine-scale": ["0.09", "bigpicture"]},
        "+10": {"--hcz-fine-scale": ["0.1", "bigpicture"]}
      }
    },
    "Focus appearance": {
      "type": "dropdown",
      "default": "Existing appearance",
      "values": {
        "Existing appearance": {},
        "Custom": {"focus.css": ["bigpicture"]}
      },
      "components": [
        {
          "name": "Highlight color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#5ac8fa",
          "css_variable": "hcz-focus-color",
          "tabs": ["bigpicture"]
        }
      ]
    },
    "Outline thickness": {
      "type": "dropdown",
      "default": "Medium",
      "values": {
        "Thin": {"--hcz-focus-width": ["1px", "bigpicture"]},
        "Medium": {"--hcz-focus-width": ["2px", "bigpicture"]},
        "Thick": {"--hcz-focus-width": ["3px", "bigpicture"]}
      }
    },
    "Glow strength": {
      "type": "dropdown",
      "default": "Medium",
      "values": {
        "Off": {
          "--hcz-glow-blur": ["0px", "bigpicture"],
          "--hcz-glow-spread": ["0px", "bigpicture"]
        },
        "Low": {
          "--hcz-glow-blur": ["6px", "bigpicture"],
          "--hcz-glow-spread": ["1px", "bigpicture"]
        },
        "Medium": {
          "--hcz-glow-blur": ["12px", "bigpicture"],
          "--hcz-glow-spread": ["2px", "bigpicture"]
        },
        "High": {
          "--hcz-glow-blur": ["20px", "bigpicture"],
          "--hcz-glow-spread": ["4px", "bigpicture"]
        }
      }
    }
  }
}
