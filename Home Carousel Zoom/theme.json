{
  "name": "Home Carousel Zoom",
  "author": "beallio",
  "version": "v1.0.0",
  "target": "Home",
  "manifest_version": 8,
  "description": "Enlarge Home carousel covers on pointer hover or controller selection. Adjust Zoom size from 100% (no extra zoom) to 130%. The focus ring and title move with the cover. Does not change the Library grid.",
  "inject": {
    "shared.css": ["bigpicture"]
  },
  "patches": {
    "Zoom size": {
      "type": "slider",
      "default": "115%",
      "values": {
        "100%": {"--hcz-scale": ["1", "bigpicture"]},
        "105%": {"--hcz-scale": ["1.05", "bigpicture"]},
        "110%": {"--hcz-scale": ["1.1", "bigpicture"]},
        "115%": {"--hcz-scale": ["1.15", "bigpicture"]},
        "120%": {"--hcz-scale": ["1.2", "bigpicture"]},
        "125%": {"--hcz-scale": ["1.25", "bigpicture"]},
        "130%": {"--hcz-scale": ["1.3", "bigpicture"]}
      }
    }
  }
}
